
# --- Almacenamiento de CVs ---
# Si NO defines estas variables, los CVs se guardan en backend/uploads/cv
# (suficiente para desarrollo local).
# En Azure SÍ son necesarias, porque App Service borra el disco en cada
# despliegue y los archivos se perderían.
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_CONTAINER="cvs"
